     eng-ita.db and eng-spa.db in DIR.                                   -->
<Corpus corpusID="example"
        title="Example of a multilingual corpus"
        linguality="multilingual"
        license="CC BY 4.0"
        version="2026-10">
  <Document docID="eng-d1"
            doc="woman"
            language="eng"
            title="A title"
            collection="story"
            collection_title="Short Stories"
            genre="fiction">
