      <Word wid="eng-s1w2" surface_form="woman" lemma="woman" pos="NN" cfrom="14" cto="19"/>
      <Concept cid="eng-s1c0" wid="eng-s1w1" clemma="beautiful" synset_tag="00217728-a"/>
