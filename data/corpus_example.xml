<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Corpus SYSTEM "ntumc.dtd">
<!-- A small multilingual corpus in the NTU-MC XML format (see
     docs/corpus-xml.md).  Load it with
       scripts/corpus_xml.py load data/corpus_example.xml -\-outdir DIR
